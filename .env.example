# Goal Discovery generator configuration (copy to .env and fill in).
# BOSS_API_KEY is a server-side secret: never commit the real value,
# never expose it to the browser.

# "mock" (default, offline deterministic) or "llm" (live model call)
BOSS_GENERATOR=mock

# Required when BOSS_GENERATOR=llm
BOSS_API_KEY=

# Optional overrides for the OpenAI-compatible endpoint
# BOSS_API_BASE=https://api.deepseek.com
# BOSS_MODEL=deepseek-chat
