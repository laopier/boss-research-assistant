# Keep the build context small and make sure secrets never enter an image layer.

# dependencies are installed inside the image by the deps stage
node_modules
.pnpm-store

# build output is regenerated inside the image
.next

# version control
.git
.gitignore

# local secrets — .env.example is a template and is intentionally kept
.env
.env.local
.env.*.local

# local tooling / editor noise
.learnbuddy
.codex-doc-review
next-env.d.ts
tsconfig.tsbuildinfo
*.log
